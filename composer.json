{
    "name": "phpresticadmin/phpresticadmin",
    "description": "Web UI and API for restic backup management",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "symfony/yaml": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
